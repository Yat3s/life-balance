.peak-page { padding: 28rpx 40rpx 48rpx; color: var(--foreground, #1c1c55); }
.peak-title { font-size: 36rpx; font-weight: 600; line-height: 1.4; letter-spacing: -0.5rpx; }
.peak-subtitle { color: #686d84; font-size: 24rpx; line-height: 1.7; margin-top: 8rpx; }
.peak-filters { margin: 26rpx 0 18rpx; }
.lot-switch { display: flex; width: 100%; padding: 6rpx; border-radius: 22rpx; background: #f1f2f8; box-sizing: border-box; }
.lot-option { flex: 1; min-height: 44px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 26rpx; color: #686d84; border-radius: 16rpx; transition: color 150ms, background-color 150ms; }
.lot-option.selected { background: #ffffff; color: var(--foreground, #1c1c55); font-weight: 600; }
.date-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 12rpx; min-height: 80rpx; }
.date-picker { flex: 1; }
.date-label { display: flex; align-items: center; min-height: 44px; gap: 14rpx; font-size: 25rpx; line-height: 1.5; }
.date-chevron { width: 10rpx; height: 10rpx; border-right: 2rpx solid #9294a6; border-bottom: 2rpx solid #9294a6; transform: rotate(45deg) translateY(-3rpx); }
.quick-date { min-height: 44px; display: flex; align-items: center; padding-left: 16rpx; color: #77709e; font-size: 24rpx; white-space: nowrap; }
.peak-card { border-radius: 28rpx; padding: 28rpx 30rpx 22rpx; margin-top: 18rpx; border: 1rpx solid rgba(221, 223, 237, 0.4); }
.period-header { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.period-name { font-size: 29rpx; font-weight: 600; line-height: 1.5; }
.period-window { color: #686d84; font-size: 23rpx; font-variant-numeric: tabular-nums; }
.period-metrics { display: flex; align-items: flex-end; gap: 48rpx; margin-top: 24rpx; }
.metric-main { flex: 1; }
.metric-secondary { flex: 1; }
.metric-label { font-size: 22rpx; color: #686d84; line-height: 1.5; }
.metric-value { font-size: 48rpx; font-weight: 600; line-height: 1.3; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.metric-secondary .metric-value { font-size: 38rpx; line-height: 1.64; }
.metric-unit { font-size: 20rpx; font-weight: 400; margin-left: 8rpx; color: #686d84; }
.metric-value.critical { color: #b64b45; }
.metric-value.low { color: #926526; }
.metric-time { min-height: 26rpx; font-size: 21rpx; color: #686d84; font-variant-numeric: tabular-nums; }
.peak-chart { width: 100%; height: 240rpx; margin-top: 12rpx; }
.period-footer { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; margin-top: 10rpx; font-size: 21rpx; line-height: 1.6; }
.inspection { color: #686d84; }
.period-cadence { color: #686d84; white-space: nowrap; }
.chart-hint { color: #686d84; font-size: 20rpx; line-height: 1.6; margin-top: 5rpx; }
.period-empty { min-height: 130rpx; display: flex; flex-direction: column; justify-content: center; margin-top: 12rpx; }
.state-title { font-size: 25rpx; color: #686d84; line-height: 1.6; }
.state-detail { margin-top: 8rpx; font-size: 22rpx; color: #686d84; line-height: 1.7; }
.peak-error { padding: 36rpx 0; }
.retry-action { display: inline-flex; margin-top: 20rpx; padding: 18rpx 28rpx; border-radius: 18rpx; color: #686d84; background: #f1f2f8; font-size: 25rpx; }
.peak-scope { margin-top: 26rpx; font-size: 21rpx; color: #686d84; line-height: 1.8; }
.loading-card { min-height: 330rpx; }
.loading-line { height: 32rpx; margin-top: 32rpx; border-radius: 8rpx; background: rgba(222, 225, 237, 0.55); }
.loading-short { width: 28%; }
.loading-wide { width: 100%; height: 100rpx; margin-top: 28rpx; }
.loading-note { color: #686d84; font-size: 22rpx; margin-top: 20rpx; }
@media (prefers-reduced-motion: reduce) { .lot-option { transition: none; } }
